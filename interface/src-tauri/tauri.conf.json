{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "g15-command-center",
  "version": "0.1.0",
  "identifier": "com.m4r0uanEkha.g15-command-center",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "G15 Command Center",
        "width": 1920,
        "height": 1080,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/dev",
      "binaries/main"
    ]
  }
}